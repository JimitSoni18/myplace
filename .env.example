# =============================================================================
# MyPlace Environment Configuration Example
# =============================================================================

# Application Environment: 'development', 'test', or 'production'
APP_ENV=development

# -----------------------------------------------------------------------------
# HTTP Ports & Listeners
# On Render Web Services, Render dynamically injects $PORT (usually 10000).
# -----------------------------------------------------------------------------
PORT=8080
PUBLIC_PORT=8080
ADMIN_PORT=8081
OWNER_PORT=8082

# -----------------------------------------------------------------------------
# Canonical Site Origins
# Used for absolute URL generation, canonical redirects, and sitemaps.
# In production on Render, set these to your actual domain or .onrender.com URLs.
# -----------------------------------------------------------------------------
PUBLIC_SITE_ORIGIN=http://localhost:8080
ADMIN_SITE_ORIGIN=http://localhost:8081
OWNER_SITE_ORIGIN=http://localhost:8082

# -----------------------------------------------------------------------------
# Database Configuration (PostgreSQL)
# Local: postgres://postgres:welcome@localhost:5432/myplace
# Render: Render Internal Database URL (or External Database URL with sslmode=require)
# -----------------------------------------------------------------------------
DATABASE_URL=postgres://postgres:welcome@localhost:5432/myplace
MAX_DB_CONNECTIONS=10

# Local Docker Compose PostgreSQL credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=welcome
POSTGRES_DB=myplace

# -----------------------------------------------------------------------------
# Authentication & Session Secrets
# Generate a cryptographically secure 32-byte base64 string:
#   openssl rand -base64 32
# -----------------------------------------------------------------------------
COOKIE_SIGNING_SECRET=generate_with_openssl_rand_base64_32

# Initial super-admin seed credentials (created by ./seed)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_to_a_secure_password

# -----------------------------------------------------------------------------
# S3 / Object Storage (Garage, AWS S3, Cloudflare R2, MinIO)
# -----------------------------------------------------------------------------
# Endpoint used by backend server to upload/delete files:
#   Local Garage: http://localhost:3900 (or http://s3:3900 within Docker network)
#   AWS S3: https://s3.us-east-1.amazonaws.com
#   Cloudflare R2: https://<account_id>.r2.cloudflarestorage.com
S3_ENDPOINT=http://localhost:3900
S3_BUCKET=myplace
AWS_ACCESS_KEY_ID=GK_your_garage_or_s3_key_id
AWS_SECRET_ACCESS_KEY=your_garage_or_s3_secret_access_key
AWS_DEFAULT_REGION=garage

# Browser-facing asset base URL:
# Templates build asset URLs as: {ASSET_BASE_URL}/{s3_key}
#   Local Garage web endpoint: http://myplace.web.docker.localhost:3903
#   Production CDN / Custom Domain: https://assets.myplace.example.com
ASSET_BASE_URL=http://myplace.web.docker.localhost:3903

# Garage-only internal secrets (for self-hosted Garage in docker-compose)
GARAGE_RPC_SECRET=generate_with_openssl_rand_hex_32
GARAGE_ADMIN_TOKEN=generate_with_openssl_rand_base64_32

# -----------------------------------------------------------------------------
# Cache & Sitemap Configuration
# -----------------------------------------------------------------------------
PAGE_CACHE_CAPACITY=50
SITEMAP_PROJECTS_RANGE=1000
SITEMAP_OWNERS_RANGE=500
SITEMAP_PROPERTIES_RANGE=2000

# Logging
RUST_LOG=info,myplace=debug
