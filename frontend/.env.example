# =============================================================================
# MyPlace Frontend Environment Variables
# =============================================================================

# For local development with Vite dev server proxying to Rust backend:
# Leave blank to use relative paths ("/api") through Vite's built-in dev proxy:
# VITE_API_URL=

# For production / standalone deployment (Cloudflare Pages):
# Set this to your Render.com backend URL (without trailing slash):
VITE_API_URL=https://myplace-backend.onrender.com
