  "query": "SELECT\n    pfp.id,\n    pfp.project_id,\n    pfp.media_id,\n    pfp.title,\n    pfp.sequence,\n    m.s3_key,\n    m.thumbnail_key\nFROM project_floor_plans pfp\nJOIN media m ON m.id = pfp.media_id\nWHERE pfp.project_id = $1\nORDER BY pfp.sequence ASC, pfp.created_at ASC;\n",
